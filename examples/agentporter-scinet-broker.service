# Host-side SciNet transport broker.
#
# Install once:
#   mkdir -p ~/.config/systemd/user
#   cp examples/agentporter-scinet-broker.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agentporter-scinet-broker
#
# The broker is intentionally separate from agentporter.service.  It exposes
# only a same-user Unix socket and owns the private SSH control path.  Agents
# and AgentPorter never use ~/.ssh or receive SSH options/credentials.
[Unit]
Description=AgentPorter SciNet host-side transport broker
After=network-online.target

[Service]
Type=simple
ExecStart=%h/repos/AgentPorter/.venv/bin/python -m agentporter.tools.scinet_broker \
  --socket %t/agentporter/scinet.sock \
  --control-socket %t/agentporter/scinet-control \
  --host trillium-gpu.alliancecan.ca \
  --user yeli
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=no
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t/agentporter

[Install]
WantedBy=default.target
