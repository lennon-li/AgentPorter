#!/usr/bin/python3
"""Local operator switch for new AgentPorter Venkata diagnostic requests."""

import os
from pathlib import Path
import pwd
import stat
import sys
import tempfile

if len(sys.argv) != 2 or sys.argv[1] not in {"on", "off", "status"}:
    raise SystemExit("Usage: venkata-access on|off|status")
user = pwd.getpwuid(os.getuid())
if user.pw_name != "operator":
    raise SystemExit("Run as operator")
directory = Path(user.pw_dir) / ".config" / "agentporter"
marker = directory / "venkata-access.enabled"
if sys.argv[1] == "on":
    if directory.is_symlink() or directory.stat().st_uid != os.getuid() or directory.stat().st_mode & 0o022:
        raise SystemExit("AgentPorter config directory must be owned by operator and not group/world writable")
    fd, name = tempfile.mkstemp(prefix=".venkata-access-", dir=directory)
    try:
        os.close(fd)
        os.replace(name, marker)
    finally:
        Path(name).unlink(missing_ok=True)
elif sys.argv[1] == "off":
    marker.unlink(missing_ok=True)
try:
    info = marker.lstat()
    enabled = stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid() and not info.st_mode & 0o022
except OSError:
    enabled = False
print("Venkata access: " + ("ON" if enabled else "OFF"))
