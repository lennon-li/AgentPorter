[Unit]
Description=Synchronize existing canonical credentials into isolated Development identities

[Service]
Type=oneshot
User=root
UMask=0077
# Set AGENTPORTER_OWNER to the ordinary credential owner in this private file.
EnvironmentFile=/etc/agentporter/credential-sync.env
ExecStart=/usr/bin/python3 -I /usr/local/libexec/agentporter/refresh-development-worker-credentials.py --apply --agents codex_review,codex_impl,codex_research,claude_agent,opencode_free,copilot_agent,agy_agent
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agentporter-dev
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
