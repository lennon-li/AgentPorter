[Unit]
Description=Synchronize existing canonical credentials into isolated A7Dev identities

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/local/libexec/agentporter/refresh-development-worker-credentials.py --apply --agents jax,liz,prof,ming,wei,phil,argie
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agentporter-dev
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
