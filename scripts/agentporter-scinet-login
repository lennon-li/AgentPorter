#!/usr/bin/env bash
set -euo pipefail

# Run this from an interactive Asgard terminal when Duo re-authentication is
# required.  The SSH master is private to the broker and is not an
# AgentPorter/agent configuration dependency.
# This is the broker-owned SSH control socket.  AgentPorter agents only use
# the broker RPC socket; they never receive this path or ~/.ssh access.
socket="${AGENTPORTER_SCINET_CONTROL_SOCKET:-$HOME/.ssh/cm-operator@trillium-gpu.alliancecan.ca:22}"
runtime="${XDG_RUNTIME_DIR:?}/agentporter"
mkdir -p "$runtime"
chmod 700 "$runtime"

if ssh -S "$socket" -O check \
    -l operator -o BatchMode=yes -o StrictHostKeyChecking=yes \
  trillium-gpu.alliancecan.ca >/dev/null 2>&1 &&
  timeout 8s ssh -S "$socket" -T -l operator \
    -o BatchMode=yes -o StrictHostKeyChecking=yes \
    -o ProxyCommand=/bin/false -o ControlMaster=no \
    trillium-gpu.alliancecan.ca /usr/bin/true >/dev/null 2>&1; then
  echo "SciNet broker session is already authenticated"
  exit 0
fi

if [[ -e "$socket" ]]; then
  rm -- "$socket"
fi

exec ssh -M -S "$socket" -N -T -f \
  -o ControlPersist=12h \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o BatchMode=no \
  -o PreferredAuthentications=publickey,keyboard-interactive \
  -o KbdInteractiveAuthentication=yes \
  -o HostbasedAuthentication=no \
  -o PubkeyAuthentication=yes \
  -o PasswordAuthentication=no \
  -o StrictHostKeyChecking=yes \
  -o ForwardAgent=no \
  -o ClearAllForwardings=yes \
  -l operator trillium-gpu.alliancecan.ca
